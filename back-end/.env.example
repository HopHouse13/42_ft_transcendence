# Copier ce fichier en .env et remplir les vraies valeurs.
# .env est ignoré par git — .env.example reste le modèle partagé avec l'équipe.

NODE_ENV=development
PORT=3000

### DATA BASE ###

# forme d'une URL de database: <SGBD>://<user>:<password>@<host>:<port>/<database>
# SGBD -> Systeme de Gestion de Base de Données

DATABASE_URL=postgres://othello_user:othello_pass@database:5432/othello_db

