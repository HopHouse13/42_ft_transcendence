# --- DATABASE ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- NESTJS BACKEND ---
NODE_ENV=development
PORT=3000
APP_URL=https://localhost:8443
JWT_SECRET= # run `openssl rand -base64 32` and paste here
JWT_EXPIRATION=600  # 10min
REFRESH_TOKEN_EXPIRATION=604800 # 7 days
PASSWORD_TOKEN_EXPIRATION=600   # 10min

# --- OAUTH & MAILING ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost:8443/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://localhost:8443/api/auth/github/callback

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- MONITORING ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY= # for instance run `openssl rand -base64 32` and copy here the value generated
GRAFANA_ENCRYPTION_KEY= # run `openssl rand -base64 32` and paste here
DISCORD_WEBHOOK_URL= # paste your Discord channel webhook URL here